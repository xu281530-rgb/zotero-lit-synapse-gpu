{
  "name": "zotero-mcp-plugin",
  "type": "module",
  "version": "1.7.0",
  "description": "Zotero MCP Plugin for Zotero 9.0.x: collection-scoped hybrid retrieval (keyword + semantic fused into one 0-1 relevance score), cursor pagination above a user threshold, on-demand abstracts, single-document full-text search, and MCP 2025-06-18 Streamable HTTP",
  "config": {
    "addonName": "Zotero MCP Plugin",
    "addonID": "zotero-mcp-plugin@autoagent.my",
    "addonRef": "zotero-mcp-plugin",
    "addonInstance": "ZoteroMCP",
    "prefsPrefix": "extensions.zotero.zotero-mcp-plugin",
    "addonVersion": "1.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookjohn/zotero-mcp.git"
  },
  "author": "cookjohn",
  "bugs": {
    "url": "https://github.com/cookjohn/zotero-mcp/issues"
  },
  "homepage": "https://github.com/cookjohn/zotero-mcp#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "build:gpu-native": "native\\vector-gpu\\build-local.cmd",
    "package:gpu-assets": "node scripts/package-gpu-assets.js",
    "build:gpu": "npm run build:gpu-native && npm run package:gpu-assets",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "npm version patch --force -m \"Release v%s\" && git push --follow-tags",
    "release:beta": "npm version prepatch --preid beta --force -m \"Release v%s\" && git push --follow-tags",
    "prepare-release": "node scripts/prepare-release.js",
    "version": "node scripts/sync-addon-version.js && npm run prepare-release && git add package.json package-lock.json update.json update-beta.json",
    "release:init": "node scripts/init-release.js",
    "test": "zotero-plugin test",
    "test:hybrid-search": "node --experimental-strip-types scripts/test-hybrid-search.js",
    "test:chunking": "node --experimental-strip-types scripts/test-chunking.js",
    "test:index-lifecycle": "node --experimental-strip-types scripts/test-index-lifecycle.js",
    "test:fulltext-on-demand": "node --experimental-strip-types scripts/test-fulltext-on-demand.js",
    "test:index-recovery": "node --experimental-strip-types scripts/test-index-recovery.js",
    "test:collection-scope": "node --experimental-strip-types scripts/test-collection-scope.js",
    "test:hybrid-candidates": "node --experimental-strip-types scripts/test-hybrid-candidates.js",
    "test:hybrid-pagination": "node --experimental-strip-types scripts/test-hybrid-pagination.js",
    "test:vector-topk": "node --experimental-strip-types scripts/test-vector-topk.js",
    "test:vector-scan-timeout": "node --experimental-strip-types scripts/test-vector-scan-timeout.js",
    "test:gpu-vector-protocol": "node --experimental-strip-types scripts/test-gpu-vector-protocol.js",
    "test:gpu-vector-status": "node --experimental-strip-types scripts/test-gpu-vector-status.js",
    "test:gpu-vector-dispatch": "node --experimental-strip-types scripts/test-gpu-vector-dispatch.js",
    "test:gpu-vector-service": "node --experimental-strip-types scripts/test-gpu-vector-service.js",
    "test:gpu-vector-process": "node --experimental-strip-types scripts/test-gpu-vector-process.js",
    "test:vector-gpu-native": "node --experimental-strip-types scripts/test-vector-gpu-native.js",
    "test:gpu-assets": "node scripts/test-gpu-assets-package.js",
    "test:gpu-xpi": "node scripts/test-gpu-assets-package.js --xpi .scaffold/build/zotero-mcp-plugin.xpi",
    "benchmark:vector-gpu": "node --experimental-strip-types --experimental-sqlite scripts/benchmark-vector-gpu.js",
    "test:http-framing": "node --experimental-strip-types scripts/test-http-framing.js",
    "test:http-transport": "node --experimental-strip-types scripts/test-http-transport.js",
    "check:mcp-framing": "node scripts/check-mcp-framing.mjs",
    "check:search-stability": "node scripts/check-search-stability.mjs",
    "test:deep-dive": "node --experimental-strip-types scripts/test-deep-dive.js",
    "test:semantic-autoupdate": "node scripts/test-semantic-autoupdate.js",
    "test:mineru-prefs": "node scripts/test-mineru-pref-persistence.js",
    "test:update": "node scripts/test-update.js",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "eslint": "^9.32.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
