{
  "name": "zotero-mcp-plugin",
  "type": "module",
  "version": "1.9.2",
  "description": "Zotero MCP Plugin for Zotero 9.0.x: one tool catalog behind MCP and HTTP, three interchangeable retrieval tools (hybrid / keyword / semantic) sharing collection+item scoping, a user threshold and cursor pagination, paged reading of attachments and indexed chunks, level-by-level collection browsing, and MCP 2025-06-18 Streamable HTTP",
  "config": {
    "addonName": "Zotero MCP Plugin",
    "addonID": "zotero-mcp-plugin@autoagent.my",
    "addonRef": "zotero-mcp-plugin",
    "addonInstance": "ZoteroMCP",
    "prefsPrefix": "extensions.zotero.zotero-mcp-plugin",
    "addonVersion": "1.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xu281530-rgb/zotero-mcp-gpu.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "build:gpu-native": "native\\vector-gpu\\build-local.cmd",
    "package:gpu-assets": "node scripts/package-gpu-assets.js",
    "build:gpu": "npm run build:gpu-native && npm run package:gpu-assets",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "version": "node scripts/sync-addon-version.js && git add package.json package-lock.json",
    "test": "zotero-plugin test",
    "test:tool-catalog": "node --experimental-strip-types scripts/test-tool-catalog.js",
    "test:docs-tool-list": "node --experimental-strip-types scripts/test-docs-tool-list.js",
    "test:cursor-identity": "node --experimental-strip-types scripts/test-cursor-identity.js",
    "test:document-chunks": "node --experimental-strip-types scripts/test-document-chunks.js",
    "test:attachment-text": "node --experimental-strip-types scripts/test-attachment-text.js",
    "test:collection-browser": "node --experimental-strip-types scripts/test-collection-browser.js",
    "test:annotation-params": "node --experimental-strip-types scripts/test-annotation-params.js",
    "test:annotation-keys": "node --experimental-strip-types scripts/test-annotation-keys.js",
    "test:item-key-kind": "node --experimental-strip-types scripts/test-item-key-kind.js",
    "test:collection-envelope": "node --experimental-strip-types scripts/test-collection-envelope.js",
    "test:hybrid-search": "node --experimental-strip-types scripts/test-hybrid-search.js",
    "test:chunking": "node --experimental-strip-types scripts/test-chunking.js",
    "test:natural-language": "node scripts/test-natural-language.js",
    "test:body-index": "node --experimental-strip-types scripts/test-body-index.js",
    "test:embedding-batching": "node --experimental-strip-types scripts/test-embedding-batching.js",
    "test:chunk-oversize": "node --experimental-strip-types scripts/test-chunk-oversize-policy.js",
    "test:index-lifecycle": "node --experimental-strip-types scripts/test-index-lifecycle.js",
    "test:fulltext-on-demand": "node --experimental-strip-types scripts/test-fulltext-on-demand.js",
    "test:index-recovery": "node --experimental-strip-types scripts/test-index-recovery.js",
    "test:collection-scope": "node --experimental-strip-types scripts/test-collection-scope.js",
    "test:hybrid-candidates": "node --experimental-strip-types scripts/test-hybrid-candidates.js",
    "test:hybrid-pagination": "node --experimental-strip-types scripts/test-hybrid-pagination.js",
    "test:vector-topk": "node --experimental-strip-types scripts/test-vector-topk.js",
    "test:find-similar": "node --experimental-strip-types scripts/test-find-similar.js",
    "test:vector-scan-timeout": "node --experimental-strip-types scripts/test-vector-scan-timeout.js",
    "test:search-timeouts": "node --experimental-strip-types scripts/test-search-timeouts.js",
    "test:keyword-hard-timeout": "node --experimental-strip-types scripts/test-keyword-hard-timeout.js",
    "test:keyword-gate-recovery": "node --experimental-strip-types scripts/test-keyword-gate-recovery.js",
    "test:keyword-gate-races": "node --experimental-strip-types scripts/test-keyword-gate-races.js",
    "test:rebuild-enumeration": "node --experimental-strip-types scripts/test-rebuild-enumeration-guard.js",
    "test:body-retry": "node --experimental-strip-types scripts/test-body-retry-policy.js",
    "test:dimension-mismatch": "node --experimental-strip-types scripts/test-dimension-mismatch.js",
    "test:dimension-mismatch-runtime": "node --experimental-strip-types scripts/test-dimension-mismatch-runtime.js",
    "test:gpu-vector-protocol": "node --experimental-strip-types scripts/test-gpu-vector-protocol.js",
    "test:gpu-vector-status": "node --experimental-strip-types scripts/test-gpu-vector-status.js",
    "test:gpu-vector-dispatch": "node --experimental-strip-types scripts/test-gpu-vector-dispatch.js",
    "test:gpu-vector-service": "node --experimental-strip-types scripts/test-gpu-vector-service.js",
    "test:gpu-vector-process": "node --experimental-strip-types scripts/test-gpu-vector-process.js",
    "test:gpu-vector-sync-refresh": "node --experimental-strip-types scripts/test-gpu-vector-sync-refresh.js",
    "test:vector-gpu-native": "node --experimental-strip-types scripts/test-vector-gpu-native.js",
    "test:gpu-assets": "node scripts/test-gpu-assets-package.js",
    "test:gpu-xpi": "node scripts/test-gpu-assets-package.js --xpi .scaffold/build/zotero-mcp-plugin.xpi",
    "benchmark:vector-gpu": "node --experimental-strip-types --experimental-sqlite scripts/benchmark-vector-gpu.js",
    "benchmark:find-similar-scaling": "node --experimental-strip-types --experimental-sqlite scripts/benchmark-find-similar-scaling.js",
    "test:http-framing": "node --experimental-strip-types scripts/test-http-framing.js",
    "test:http-transport": "node --experimental-strip-types scripts/test-http-transport.js",
    "check:mcp-framing": "node scripts/check-mcp-framing.mjs",
    "check:search-stability": "node scripts/check-search-stability.mjs",
    "test:deep-dive": "node --experimental-strip-types scripts/test-deep-dive.js",
    "test:semantic-autoupdate": "node scripts/test-semantic-autoupdate.js",
    "test:mineru-prefs": "node scripts/test-mineru-pref-persistence.js",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "eslint": "^9.32.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
