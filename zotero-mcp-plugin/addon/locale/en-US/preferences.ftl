# --- LLM Wiki ---
pref-wiki-title = LLM Wiki and long-term research memory
pref-wiki-desc = Stores reusable claims, concepts, relations, and traceable evidence in an independent database. It does not duplicate ordinary paper summaries and never calls an LLM by itself.
pref-wiki-permission-note = Wiki database updates are a separate permission category from editing Zotero items. Search-index reset or rebuild never deletes this long-term knowledge.
pref-wiki-enabled-text = Enable LLM Wiki
pref-wiki-enabled-sub = Expose the Wiki tools and calculate the Wiki retrieval route during hybrid search.
pref-wiki-auto-write-text = Allow AI to consolidate Wiki knowledge automatically
pref-wiki-auto-write-sub = Off by default. When off, every wiki_commit requires explicit local confirmation.
pref-wiki-write-mode-label = Wiki write mode
pref-wiki-write-mode-hint = Auto is effective only when automatic consolidation is also enabled.
pref-wiki-write-mode-confirm = Confirm each commit
pref-wiki-write-mode-auto = Automatic
pref-wiki-shadow-text = Wiki retrieval Shadow Mode
pref-wiki-shadow-sub = Calculate and report Wiki candidates without changing Keyword + Semantic ranking.
pref-wiki-min-score-label = Wiki relevance threshold
pref-wiki-min-score-hint = Uncalibrated by default. Keep Shadow Mode on while measuring against real Zotero searches.
pref-wiki-rrf-weight-label = Wiki RRF weight
pref-wiki-rrf-weight-hint = Used only outside Shadow Mode. No theoretical default is imposed; 0 prevents Wiki from affecting ranking.
pref-wiki-timeout-label = Wiki search timeout (ms)
pref-wiki-timeout-hint = A timeout or empty Wiki silently falls back to the existing Keyword + Semantic routes.
pref-hybrid-chunk-locked = Search index or Wiki data already exists, so the Chunk structure is locked. Delete the relevant indexes and all Wiki data before changing these settings.
pref-embedding-identity-locked = Vector index or Wiki Claim Embedding data already exists. The embedding model and dimensions are locked until all dependent vector data is deleted. API Key and Base URL remain editable.
pref-wiki-clear-button = Delete all Wiki data
pref-wiki-clear-confirm = This permanently deletes all Wiki Concepts, Aliases, Pages, Claims, Relations, Evidence, and Claim Embeddings. Keyword and vector search indexes are not deleted. Continue?
pref-wiki-clear-error = Failed to delete Wiki data
pref-wiki-reading-notes-clear-button = Delete all AI notes
pref-wiki-reading-notes-clear-confirm = This permanently deletes all AI-generated Wiki Reading Note Markdown attachments in every library. Wiki data and search indexes are not deleted. Continue?
pref-wiki-reading-notes-cleared = Deleted { $count } AI reading notes
pref-wiki-reading-notes-clear-none = No AI reading notes found
pref-wiki-reading-notes-clear-partial = Deleted { $count } AI reading notes; { $failed } operations failed (see the debug log)
pref-wiki-reading-notes-clear-error = Failed to delete AI reading notes
pref-wiki-data-statistics = Wiki data: { $pages } pages, { $claims } claims, { $evidence } evidence, { $embeddings } embeddings
pref-wiki-data-statistics-error = Wiki statistics unavailable
